{
  "name": "zotero-research-bridge",
  "type": "module",
  "version": "0.1.0",
  "description": "Local, authenticated research-management bridge for Zotero",
  "config": {
    "addonName": "Zotero Research Bridge",
    "addonID": "zotero-research-bridge@local.litzeng",
    "addonRef": "zotero-research-bridge",
    "addonInstance": "ZoteroResearchBridge",
    "prefsPrefix": "extensions.zotero.zotero-research-bridge"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z-jjj-y/zotero-research-bridge.git"
  },
  "author": "Zotero Research Bridge contributors",
  "bugs": {
    "url": "https://github.com/z-jjj-y/zotero-research-bridge/issues"
  },
  "homepage": "https://github.com/z-jjj-y/zotero-research-bridge#readme",
  "license": "MIT",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "test": "zotero-plugin test",
    "test:unit": "mocha",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.4"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.2.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^5.2.1",
    "eslint": "^9.32.0",
    "mocha": "^11.7.1",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "zotero-plugin-scaffold": "0.8.0",
    "zotero-types": "4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
